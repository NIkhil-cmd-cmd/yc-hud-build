# OpenHive Engine — copy to .env and fill in

HUD_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
FIREWORKS_API_KEY=
EXA_API_KEY=

# Engine WebSocket port (Swift EngineBridge connects here)
OPENHIVE_ENGINE_PORT=8765

# Agent loop: auto (LLM if any key set) | llm | scripted
# OPENHIVE_AGENT_EXPERT=auto
# OPENHIVE_AGENT_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=

# Optional model overrides
# OPENHIVE_EXPERT_MODEL=accounts/fireworks/models/deepseek-v3
# OPENHIVE_FALLBACK_MODEL=MiniMax-Text-01
# OPENHIVE_T2_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
