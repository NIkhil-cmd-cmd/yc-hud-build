# Copy to repo root .env (or HUD/.env) — get a key at https://hud.ai
HUD_API_KEY=

# Optional overrides (defaults work for beta)
# HUD_API_URL=https://api.beta.hud.ai
# HUD_GATEWAY_URL=https://inference.beta.hud.ai
# HUD_RL_URL=https://rl.beta.hud.ai
# HUD_RUNTIME_URL=https://mcp.beta.hud.ai

# Local trace dumps from `hud eval` (optional)
# HUD_TELEMETRY_LOCAL_DIR=./HUD/.telemetry
